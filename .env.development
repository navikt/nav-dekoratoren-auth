# What `pnpm dev` runs with. test/mocks/dev.ts answers these test hosts from test/fixtures.ts.
NAIS_TOKEN_ENDPOINT=http://texas.test/api/v1/token
NAIS_TOKEN_INTROSPECTION_ENDPOINT=http://texas.test/api/v1/introspect
PDL_ORIGIN=http://pdl-api.test
PDL_TOKEN_TARGET=api://test-fss.pdl.pdl-api/.default
# Makes the user keys in /identity. Not a secret: the cluster gets its own from the Nais secret nav-dekoratoren-auth.
USER_KEY_SECRET=a-test-secret-of-at-least-32-characters
