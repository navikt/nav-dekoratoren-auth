// Type-check only (`pnpm lint`): Node runs the TypeScript in server/ directly, stripping the types
{
	"compilerOptions": {
		"target": "es2024",
		"lib": ["es2024"],
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"types": ["node"],
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"erasableSyntaxOnly": true,
		"verbatimModuleSyntax": true,
		"allowImportingTsExtensions": true
	},
	"include": ["server/**/*.ts", "test/**/*.ts", "*.config.ts"]
}
